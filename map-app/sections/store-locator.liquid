{% comment %}
  Standalone theme section version of Distributor Map Store Locator.

  Copy this file to the theme's sections/ directory. Also copy these assets
  to the theme's assets/ directory:
  - store-locator.css
  - store-locator.js

  The section uses the existing app proxy endpoint and native Shopify color
  schemes. The App Block remains available separately.
{% endcomment %}

<section
  class="dm-locator color-{{ section.settings.color_scheme }}"
  data-dm-locator
  data-endpoint="/apps/distributor-map/search"
  data-dm-marker-style="{{ section.settings.marker_style }}"
  data-dm-card-style="{{ section.settings.location_card_style }}"
  data-dm-body-style="{{ section.settings.widget_body_style }}"
  data-dm-marker-shape="{{ section.settings.photo_marker_shape }}"
  style="--dm-list-height-desktop: {{ section.settings.list_height_desktop }}px; --dm-list-height-mobile: {{ section.settings.list_height_mobile }}px; --dm-marker-size: {{ section.settings.marker_size }}px; --dm-marker-radius: {{ section.settings.photo_marker_shape }}; --dm-marker-border-color: {{ section.settings.photo_marker_border_color }}; --dm-marker-border-width: {{ section.settings.photo_marker_border_width }}px;"
>
  <div class="dm-locator__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="dm-locator__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="dm-locator__heading rte">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="dm-locator__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </div>

  </div>

  <form class="dm-locator__search" data-dm-search>
    <label class="visually-hidden" for="dm-locator-query-{{ section.id }}">Search locations</label>
    <div class="dm-locator__search-field">
    <input id="dm-locator-query-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
    <button type="button" class="dm-locator__clear-search" data-dm-clear-search aria-label="Clear search" hidden>&#215;</button>
    </div>
    <button type="submit">Search</button>
  </form>

  <button type="button" class="dm-locator__mobile-list-toggle" data-dm-open-list aria-expanded="false">
    {{ 'store_locator.view_locations' | t }}
  </button>

  <div class="dm-locator__body">
    <aside class="dm-locator__results" aria-live="polite" aria-label="{{ 'store_locator.locations_aria' | t }}">
      <div class="dm-locator__results-head">
        <strong data-dm-count>0 locations</strong>
        <span data-dm-status></span>
        <button type="button" class="dm-locator__mobile-list-close" data-dm-close-list aria-label="{{ 'store_locator.close_locations' | t }}">&#215;</button>
      </div>
      <div data-dm-list></div>
      <p class="dm-locator__empty" data-dm-empty hidden>No locations found.</p>
      <p class="dm-locator__error" data-dm-error hidden>Unable to load locations.</p>
      <div class="dm-locator__results-scrollbar" data-dm-results-scrollbar aria-hidden="true"><span></span></div>
    </aside>
    <div class="dm-locator__map" data-dm-map role="region" aria-label="Location map">
      <button type="button" class="dm-locator__search-area" data-dm-search-area>{{ 'store_locator.search_area' | t }}</button>
      <div class="dm-locator__map-placeholder"><span>Loading map…</span></div>
    </div>
  </div>
</section>

<script type="application/json" data-dm-locator-snapshot>
[
  {% for location in metaobjects['app--427145920513--distributor_location_v2'].values %}
    {
      "id": {{ forloop.index0 | json }},
      "externalId": {{ location.external_id.value | default: location.handle | default: location.id | json }},
      "metaobjectId": {{ location.id | json }},
      "handle": {{ location.handle | json }},
      "name": {{ location.name.value | json }},
      "addressLine1": {{ location.address_line_1.value | json }},
      "city": {{ location.city.value | json }},
      "state": {{ location.state.value | json }},
      "postalCode": {{ location.postal_code.value | json }},
      "country": {{ location.country.value | json }},
      "countryCode": {{ location.country_code.value | json }},
      "latitude": {{ location.latitude.value | json }},
      "longitude": {{ location.longitude.value | json }},
      "phones": {{ location.phones.value | json }},
      "emails": {{ location.emails.value | json }},
      "websites": {{ location.websites.value | json }},
      "description": {{ location.description.value | json }},
      "imageUrls": {{ location.image_urls.value | json }},
      "buttonUrl": {{ location.button_url.value | json }},
      "type": {{ location.type.value | json }},
      "published": {{ location.published.value | json }},
      "productIds": {{ location.product_ids.value | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
</script>


<script type="application/json" data-dm-locator-translations>
  {
    "viewDetails": {{ 'store_locator.view_details' | t | json }},
    "close": {{ 'store_locator.close' | t | json }},
    "chooseNavigation": {{ 'store_locator.choose_navigation' | t | json }},
    "automaticNavigation": {{ 'store_locator.automatic_navigation' | t | json }},
    "getDirections": {{ 'store_locator.get_directions' | t | json }},
    "navigation": {{ 'store_locator.navigation' | t | json }},
    "loading": {{ 'store_locator.loading' | t | json }},
    "noLocationsArea": {{ 'store_locator.no_locations_area' | t | json }},
    "mapUnavailable": {{ 'store_locator.map_unavailable' | t | json }}
  }
</script>

{{ 'store-locator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'store-locator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Store locator",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIND US" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Find a distributor near you</p>" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Search our retail network and discover where to find our products.</p>" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search by location name" },
    { "type": "select", "id": "location_card_style", "label": "Location card style", "default": "default", "options": [
      { "value": "default", "label": "Default" },
      { "value": "compact", "label": "Compact" },
      { "value": "photo", "label": "Photo card" },
      { "value": "photo-left", "label": "Photo left" }
    ] },
    { "type": "select", "id": "widget_body_style", "label": "Widget body style", "default": "default", "options": [
      { "value": "default", "label": "Default" },
      { "value": "borderless", "label": "Borderless" },
      { "value": "soft", "label": "Soft card" }
    ] },
    { "type": "select", "id": "marker_style", "label": "Marker style", "default": "default", "options": [
      { "value": "default", "label": "Default marker" },
      { "value": "photo", "label": "Photo marker" }
    ] },
    { "type": "range", "id": "marker_size", "label": "Marker size", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 48 },
    { "type": "select", "id": "photo_marker_shape", "label": "Photo marker shape", "default": "50%", "options": [
      { "value": "50%", "label": "Circle" },
      { "value": "14px", "label": "Rounded" },
      { "value": "0", "label": "Square" },
      { "value": "raindrop", "label": "Raindrop" }
    ] },
    { "type": "color", "id": "photo_marker_border_color", "label": "Photo marker border", "default": "#FFFFFF" },
    { "type": "range", "id": "photo_marker_border_width", "label": "Photo marker border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "list_height_desktop", "label": "Locations height on desktop", "min": 280, "max": 1000, "step": 10, "unit": "px", "default": 540 },
    { "type": "range", "id": "list_height_mobile", "label": "Locations height on mobile", "min": 240, "max": 1000, "step": 10, "unit": "px", "default": 500 }
  ]
}
{% endschema %}
