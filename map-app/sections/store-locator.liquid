{% comment %}
  Standalone theme section version of Distributor Map Store Locator.

  Copy this file to the theme's sections/ directory. Also copy these assets
  to the theme's assets/ directory:
  - store-locator.css
  - store-locator.js

  The section uses the existing app proxy endpoint and native Shopify color
  schemes. The App Block remains available separately.
{% endcomment %}

<section
  class="dm-locator color-{{ section.settings.color_scheme }}"
  data-dm-locator
  data-endpoint="/apps/distributor-map/search"
  data-dm-marker-style="{{ section.settings.marker_style }}"
  data-dm-marker-shape="{{ section.settings.photo_marker_shape }}"
  style="--dm-list-height-desktop: {{ section.settings.list_height_desktop }}px; --dm-list-height-mobile: {{ section.settings.list_height_mobile }}px; --dm-marker-size: {{ section.settings.marker_size }}px; --dm-marker-radius: {{ section.settings.photo_marker_shape }}; --dm-marker-border-color: {{ section.settings.photo_marker_border_color }}; --dm-marker-border-width: {{ section.settings.photo_marker_border_width }}px;"
>
  <div class="dm-locator__header">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="dm-locator__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="dm-locator__heading rte">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="dm-locator__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    {% if section.settings.enable_geolocation %}
      <button type="button" class="dm-locator__locate" data-dm-locate>
        Use my location
      </button>
    {% endif %}
  </div>

  <form class="dm-locator__search" data-dm-search>
    <label class="visually-hidden" for="dm-locator-query-{{ section.id }}">Search locations</label>
    <input id="dm-locator-query-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off">
    <select name="radius" aria-label="Search radius">
      <option value="20">20 km</option>
      <option value="50" selected>50 km</option>
      <option value="100">100 km</option>
      <option value="200">200 km</option>
    </select>
    <button type="submit">Search</button>
  </form>

  <button type="button" class="dm-locator__mobile-list-toggle" data-dm-open-list aria-expanded="false">
    View locations
  </button>

  <div class="dm-locator__body">
    <aside class="dm-locator__results" aria-live="polite" aria-label="Locations">
      <div class="dm-locator__results-head">
        <strong data-dm-count>0 locations</strong>
        <span data-dm-status></span>
        <button type="button" class="dm-locator__mobile-list-close" data-dm-close-list aria-label="Close locations">&#215;</button>
      </div>
      <div data-dm-list></div>
      <p class="dm-locator__empty" data-dm-empty hidden>No locations found.</p>
      <p class="dm-locator__error" data-dm-error hidden>Unable to load locations.</p>
    </aside>
    <div class="dm-locator__map" data-dm-map role="region" aria-label="Location map">
      <div class="dm-locator__map-placeholder"><span>Loading map…</span></div>
    </div>
  </div>
</section>

{{ 'store-locator.css' | asset_url | stylesheet_tag }}
<script src="{{ 'store-locator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Store locator",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FIND US" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Find a distributor near you</p>" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Search our retail network and discover where to find PickAqua.</p>" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "City, postcode, or address" },
    { "type": "checkbox", "id": "enable_geolocation", "label": "Show use location button", "default": true },
    { "type": "select", "id": "marker_style", "label": "Marker style", "default": "default", "options": [
      { "value": "default", "label": "Default marker" },
      { "value": "photo", "label": "Photo marker" }
    ] },
    { "type": "range", "id": "marker_size", "label": "Marker size", "min": 28, "max": 96, "step": 2, "unit": "px", "default": 48 },
    { "type": "select", "id": "photo_marker_shape", "label": "Photo marker shape", "default": "50%", "options": [
      { "value": "50%", "label": "Circle" },
      { "value": "14px", "label": "Rounded" },
      { "value": "0", "label": "Square" },
      { "value": "raindrop", "label": "Raindrop" }
    ] },
    { "type": "color", "id": "photo_marker_border_color", "label": "Photo marker border", "default": "#FFFFFF" },
    { "type": "range", "id": "photo_marker_border_width", "label": "Photo marker border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "list_height_desktop", "label": "Locations height on desktop", "min": 280, "max": 1000, "step": 10, "unit": "px", "default": 540 },
    { "type": "range", "id": "list_height_mobile", "label": "Locations height on mobile", "min": 240, "max": 1000, "step": 10, "unit": "px", "default": 500 }
  ]
}
{% endschema %}
